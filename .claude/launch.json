{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Static site (http-server)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["http-server", "public", "-p", "8080"],
      "port": 8080
    },
    {
      "name": "deploy:app (wrangler dev)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "dev", "--ip", "127.0.0.1", "--port", "3850"],
      "port": 3850
    }
  ]
}
